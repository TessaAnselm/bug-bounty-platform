# Copy this file to .env and fill in values
# Never commit .env

# PostgreSQL
POSTGRES_USER=bounty
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bountydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bounty:changeme@localhost:5432/bountydb

# Temporal
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default

# Dashboard
# API key is set automatically by start.sh (SHA-256 hash stored here, not plaintext)
DASHBOARD_API_KEY=
DASHBOARD_HOST=127.0.0.1  # loopback only — invisible to the network
DASHBOARD_PORT=8000

# Notifications
DISCORD_WEBHOOK_URL=

# MCP Server
MCP_SERVER_PORT=3000

# OSINT API keys (all optional — sources skip gracefully if key is absent)
URLSCAN_API_KEY=         # urlscan.io — free tier available
GITHUB_TOKEN=            # GitHub personal access token — free
SECURITYTRAILS_API_KEY=  # securitytrails.com — free tier: 50 queries/month
WHOXY_API_KEY=           # whoxy.com — pay-per-query (~$2 per 5000 queries)

# Recon tools (paths if not in system PATH)
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx
KATANA_PATH=katana
GAU_PATH=gau
GOWITNESS_PATH=gowitness
NUCLEI_PATH=nuclei
TRUFFLEHOG_PATH=trufflehog
